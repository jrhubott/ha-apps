name: "{name}"
version: "{version}"
slug: {slug}
description: >-
  Music Assistant server with Hue lights that follow a speaker. Unofficial build from
  {server_fork} ({server_ref}).
url: https://github.com/{repo}
arch:
  - amd64
  - aarch64
homeassistant_api: true
hassio_api: true
hassio_role: manager
discovery:
  - music_assistant
  - mcp
auth_api: true
host_network: true
ingress: true
ingress_port: 8094
audio: true
panel_icon: mdi:music-assistant
panel_title: Music Assistant
panel_admin: false
map:
  - media:rw
  - ssl:ro
  - share:ro
init: false
backup_exclude:
  - cache.db
  - collage_images/*
  - .cache/*
  - library.db.backup
stage: {stage}
image: {image}
tmpfs: true
options:
  log_level: info
  safe_mode: false
schema:
  log_level: list(debug|info|warning|error)
  safe_mode: bool
privileged:
  - SYS_ADMIN
  - DAC_READ_SEARCH
